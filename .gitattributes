# Store and check out text files with LF line endings on every OS.
* text=auto eol=lf

# Binary files: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.wasm binary
*.scip binary
*.woff binary
*.woff2 binary
