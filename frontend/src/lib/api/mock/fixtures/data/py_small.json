":"tree_sitter","site":null,"src":"py:tests/test_cart.py:TestGiftCart:class"},{"confidence":0.15,"dst":"py:src/shop/cart.py:Cart.add:method","kind":"calls","meta":{"candidates":2,"count":1,"tier":"T6"},"provenance":"name_match","site":{"end_col":37,"end_line":7,"start_col":4,"start_line":7},"src":"py:tests/test_cart.py:test_add_rounds_prices:test"},{"confidence":0.15,"dst":"py:src/shop/cart.py:GiftCart.add:method","kind":"calls","meta":{"candidates":2,"count":1,"tier":"T6"},"provenance":"name_match","site":{"end_col":37,"end_line":7,"start_col":4,"start_line":7},"src":"py:tests/test_cart.py:test_add_rounds_prices:test"},{"confidence":0.95,"dst":"py:src/shop/app.py:get_cart:function","kind":"routes_to","meta":{},"provenance":"tree_sitter","site":{"end_col":28,"end_line":9,"start_col":0,"start_line":9},"src":"route:src/shop/app.py:GET /carts/{cart_id}"},{"confidence":0.95,"dst":"py:src/shop/app.py:add_item:function","kind":"routes_to","meta":{},"provenance":"tree_sitter","site":{"end_col":35,"end_line":15,"start_col":0,"start_line":15},"src":"route:src/shop/app.py:POST /carts/{cart_id}/items"}],"files":{"src/shop/__init__.py":"\"\"\"A tiny shop used as a RepoAtlas test fixture.\"\"\"\n\nfrom shop.app import create_app\nfrom shop.cart import Cart\n\n__all__ = [\"Cart\", \"create_app\"]\n","src/shop/app.py":"from fastapi import FastAPI\n\nfrom .cart import Cart\n\napp = FastAPI()\n_carts: dict[int, Cart] = {}\n\n\n@app.get(\"/carts/{cart_id}\")\nasync def get_cart(cart_id: int) -> dict[str, str]:\n    cart = _carts.setdefault(cart_id, Cart())\n    return {\"total\": cart.describe()}\n\n\n@app.post(\"/carts/{cart_id}/items\")\ndef add_item(cart_id: int, name: str, price: str) -> None:\n    from decimal import Decimal\n\n    _carts[cart_id].add(name, Decimal(price))\n\n\ndef create_app() -> FastAPI:\n    return app\n","src/shop/cart.py":"from __future__ import annotations\n\nfrom decimal import Decimal\n\nfrom shop.utils.helpers import format_price, round_money\n\n\nclass Cart:\n    \"\"\"A shopping cart.\"\"\"\n\n    def __init__(self) -> None:\n        self.items: list[tuple[str, Decimal]] = []\n\n    def add(self, name: str, price: Decimal) -> None:\n        self.items.append((name, round_money(price)))\n\n    @property\n    def total(self) -> Decimal:\n        return sum((price for _, price in self.items), Decimal(0))\n\n    def _discount(self) -> Decimal:\n        return Decimal(0)\n\n    def describe(self) -> str:\n        return format_price(self.total - self._discount())\n\n\nclass GiftCart(Cart):\n    def add(self, name: str, price: Decimal) -> None:\n        super().add(name, Decimal(0))\n","src/shop/utils/__init__.py":"\"\"\"Shared helpers.\"\"\"\n","src/shop/utils/helpers.py":"from decimal import ROUND_HALF_UP, Decimal\n\n\ndef round_money(value: Decimal) -> Decimal:\n    return value.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n\n\ndef format_price(value: Decimal) -> str:\n    def with_symbol(text: str) -> str:\n        return f\"${text}\"\n\n    return with_symbol(str(round_money(value)))\n\n\ndef chunks(items: list[int], size: int):\n    for start in range(0, len(items), size):\n        yield items[start : start + size]\n\n\ntry:\n    from orjson import dumps\nexcept ImportError:\n\n    def dumps(obj: object) -> bytes:\n        import json\n\n        return json.dumps(obj).encode()\n","tests/conftest.py":"import pytest\n\nfrom shop.cart import Cart\n\n\n@pytest.fixture\ndef cart() -> Cart:\n    return Cart()\n","tests/test_cart.py":"from decimal import Decimal\n\nfrom shop.cart import Cart, GiftCart\n\n\ndef test_add_rounds_prices(cart: Cart) -> None:\n    cart.add(\"tea\", Decimal(\"1.005\"))\n    assert cart.total == Decimal(\"1.01\")\n\n\nclass TestGiftCart:\n    def test_gifts_are_free(self) -> None:\n        cart = GiftCart()\n        cart.add(\"card\", Decimal(\"5\"))\n        assert cart.total == 0\n"}}
