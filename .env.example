# Copy this file to .env and adjust. Never commit .env.
# RepoAtlas reads REPOATLAS_* variables from the environment, or from the nearest .env file
# at or above the directory you run commands from.

# Postgres from infra/docker-compose.yml (host port 5433 by default).
REPOATLAS_DATABASE_URL=postgresql+psycopg://repoatlas:repoatlas@localhost:5433/repoatlas

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL. Format: console (readable) or json.
REPOATLAS_LOG_LEVEL=INFO
REPOATLAS_LOG_FORMAT=console

# Optional: a GitHub token raises the GitHub API limit from 60 to 5,000 requests per hour.
# A fine-grained token with no extra permissions is enough for public repos.
REPOATLAS_GITHUB_TOKEN=

# Optional for now: needed once LLM features exist.
REPOATLAS_ANTHROPIC_API_KEY=

# Where RepoAtlas keeps local working files (clones, model caches).
REPOATLAS_DATA_DIR=.repoatlas
