# Copy this file to .env and adjust. Never commit .env.
# RepoAtlas reads REPOATLAS_* variables from the environment, or from the nearest .env file
# at or above the directory you run commands from.

# Postgres from infra/docker-compose.yml (host port 5433 by default).
REPOATLAS_DATABASE_URL=postgresql+psycopg://repoatlas:repoatlas@localhost:5433/repoatlas

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL. Format: console (readable) or json.
REPOATLAS_LOG_LEVEL=INFO
REPOATLAS_LOG_FORMAT=console

# Optional: a GitHub token raises the GitHub API limit from 60 to 5,000 requests per hour.
# A fine-grained token with no extra permissions is enough for public repos.
REPOATLAS_GITHUB_TOKEN=

# Needed for answers (LLM calls cost money; tests never need it).
REPOATLAS_ANTHROPIC_API_KEY=

# LLM roles and settings (defaults shown). Prices are dollars per million tokens (JSON).
# REPOATLAS_LLM_SMALL_MODEL=claude-haiku-5-5
# REPOATLAS_LLM_LARGE_MODEL=claude-sonnet-5-5
# REPOATLAS_LLM_SMALL_EFFORT=low
# REPOATLAS_LLM_LARGE_EFFORT=medium
# REPOATLAS_LLM_TIMEOUT_S=120
# REPOATLAS_LLM_MAX_RETRIES=3
# REPOATLAS_LLM_PRICES={"claude-sonnet-5-5": {"input": 2.0, "output": 10.0, "cache_read": 0.1, "cache_write": 2.5}}

# Where RepoAtlas keeps local working files (clones, model caches).
REPOATLAS_DATA_DIR=.repoatlas

# API: origins the web app is served from (comma-separated); only these may call the API
# from a browser (CORS).
REPOATLAS_WEB_ORIGINS=http://localhost:3000

# Rate limits per client (defaults shown). Clients are told apart by a salted hash of their
# address; without a salt, a random one is made at startup.
# REPOATLAS_BUILDS_PER_HOUR=5
# REPOATLAS_READS_PER_MINUTE=120
# REPOATLAS_RATE_LIMIT_SALT=

# Background jobs (defaults shown). A worker holds a lease on its job and renews it with
# heartbeats; a job whose worker goes quiet for the whole lease is retried by another worker,
# after the delays in the backoff list (JSON, seconds), up to the maximum number of attempts.
# REPOATLAS_JOB_LEASE_S=60
# REPOATLAS_JOB_HEARTBEAT_S=15
# REPOATLAS_JOB_MAX_ATTEMPTS=3
# REPOATLAS_JOB_RETRY_BACKOFF_S=[10, 60, 300]
# REPOATLAS_JOB_TIMEOUT_S=3600
