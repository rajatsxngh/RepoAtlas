# Production limits (DEP-5): caps for a deployment other people can reach. Every value is at
# most the development default in backend/src/repoatlas/config.py (a test checks this file).
# Use them as the backend's environment on a hosted deployment (docs/deploy.md), or copy the
# lines into infra/selfhost.env.

# Spending: all LLM calls together, per UTC day. Over it, answers refuse with "budget".
REPOATLAS_DAILY_SPEND_CAP_USD=2
# One answer may cost at most this much (worst case, checked before the call).
REPOATLAS_ANSWER_MAX_COST_USD=0.15

# Per client (an address, hashed) and UTC day.
REPOATLAS_ASKS_PER_DAY=20
REPOATLAS_BUILDS_PER_DAY=3
# Per client and hour or minute (token buckets).
REPOATLAS_ASKS_PER_HOUR=10
REPOATLAS_BUILDS_PER_HOUR=3
REPOATLAS_READS_PER_MINUTE=120

# Builds running at once, across all workers.
REPOATLAS_JOB_MAX_RUNNING=2
# One build attempt may run at most this long (seconds).
REPOATLAS_JOB_TIMEOUT_S=1800

# Repository size: GitHub-reported size (KB, includes history), source files after skip
# rules, and bytes per file.
REPOATLAS_MAX_REPO_SIZE_KB=200000
REPOATLAS_MAX_SOURCE_FILES=3000
REPOATLAS_MAX_FILE_BYTES=500000
