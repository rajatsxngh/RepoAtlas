# Settings for the self-hosted stack (infra/compose.selfhost.yml).
#   cp infra/selfhost.env.example infra/selfhost.env
# infra/selfhost.env is ignored by git. Never commit real values.

# Required. The access token visitors type once; make it long and random, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REPOATLAS_ACCESS_TOKEN=
# Required. The database password (used only inside the compose network).
POSTGRES_PASSWORD=

# Answers. Set an Anthropic API key for real answers (calls cost money; the daily cap below
# limits them)...
REPOATLAS_ANTHROPIC_API_KEY=
# ...or run without a model: every answer is a labelled stand-in that only cites the code that
# was retrieved. Use "offline" to try the stack without a key. Not both.
REPOATLAS_LLM_TRANSPORT=anthropic

# Optional. A GitHub token raises GitHub's rate limit for repository checks (no scopes needed).
REPOATLAS_GITHUB_TOKEN=

# Where the web app listens on this machine.
REPOATLAS_WEB_PORT=8080
REPOATLAS_WEB_BIND=127.0.0.1
# The address visitors use, when it is not http://localhost:8080.
# REPOATLAS_PUBLIC_ORIGIN=https://atlas.example.org

# Limits (these are the defaults).
REPOATLAS_DAILY_SPEND_CAP_USD=5
REPOATLAS_ASKS_PER_DAY=20
REPOATLAS_BUILDS_PER_DAY=3
REPOATLAS_JOB_MAX_RUNNING=2

# Image names. Change REPOATLAS_VERSION to run (or roll back to) another build; see
# docs/runbook.md.
# REPOATLAS_IMAGE_PREFIX=repoatlas
# REPOATLAS_VERSION=local
